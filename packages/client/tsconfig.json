{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true, "isolatedModules": true, "noEmit": true,
    "allowImportingTsExtensions": false, "types": ["vite/client"]
  },
  "include": ["src", "test", "vite.config.ts"]
}
